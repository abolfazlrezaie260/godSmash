{
  "name": "godsmash",
  "version": "0.1.0",
  "private": true,
  "description": "GodSmash web and mobile application",
  "scripts": {
    "build": "node scripts/build-web.cjs",
    "build:verify": "node scripts/build-web.cjs --verify",
    "build:clean": "node scripts/build-web.cjs --clean",
    "test": "node --test",
    "test:build": "node --test tests/mobile-build.test.cjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run build && cap sync android && cap open android",
    "mobile:ios": "npm run build && cap sync ios && cap open ios",
    "mobile:doctor": "cap doctor"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/vazirmatn": "5.3.0",
    "tailwindcss": "3.4.17",
    "three": "0.128.0"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  }
}
